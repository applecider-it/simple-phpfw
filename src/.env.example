SFW_DEBUG=true
#SFW_DEBUG=false

#SFW_PREFIX=/public
SFW_PREFIX=

# DB設定
SFW_DATABASE_DRIVER=mysql
SFW_DATABASE_HOST=127.0.0.1
SFW_DATABASE_DATABASE=simple_phpfw_development
SFW_DATABASE_USERNAME=root
SFW_DATABASE_PASSWORD=
SFW_DATABASE_CHARSET=utf8mb4

# Pusher関連
VITE_PUSHER_APP_KEY=app-key
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_APP_CLUSTER=mt1

PUSHER_APP_KEY=app-key
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_APP_ID=app-id
PUSHER_APP_SECRET=app-secret
PUSHER_USE_TLS=false
